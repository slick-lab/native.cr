# .gitattributes

# Auto detect text files
* text=auto

# Source files
*.cr text diff=crystal
*.ecr text
*.yml text
*.yaml text
*.json text
*.md text diff=markdown
*.txt text

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Makefiles
Makefile text eol=lf
*.mk text eol=lf

# Config files
.gitattributes text
.gitignore text
.editorconfig text

# Documentation
docs/** linguist-documentation
*.md linguist-documentation

# Binaries
*.so binary
*.a binary
*.dylib binary
*.o binary
*.dSYM binary
*.crash binary
*.png binary
*.jpg binary
*.ico binary
*.icns binary

# Archives
*.zip binary
*.tar.gz binary
*.tgz binary
*.dmg binary
