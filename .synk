# .snyk

version: v1.0.0
ignore:
  'SNYK-CC-00001':
    - '*':
        reason: 'False positive - no actual vulnerability'
        expires: 2027-01-01T00:00:00.000Z
  'SNYK-CC-00002':
    - 'src/native/engine/**/*.c':
        reason: 'C engine code is wrapped by Crystal FFI'
        expires: 2027-01-01T00:00:00.000Z

exclude:
  global:
    - '**/.native_cache/**'
    - '**/build/**'
    - '**/dist/**'
    - '**/lib/**'
    - '**/*.dSYM/**'
    - '**/examples/**'
    - '**/test/**'
    - '**/spec/**'
    - '**/benchmark/**'
  code:
    - 'src/native/engine/android/android_native_app_glue.c'
    - 'src/native/engine/ios/build.sh'

patch:
  'SNYK-CC-00003':
    - 'src/native/engine/android/native.c':
        patch: 'patches/android_ndk_fix.patch'

project:
  - package-manager: crystal
    target: shard.yml
  - package-manager: gomod
    target: go.mod
  - package-manager: docker
    target: Dockerfile

severity:
  - high
  - critical

security:
  - code
  - container
  - open-source

language-settings:
  crystal:
    enabled: true
    build-command: 'crystal build src/native.cr'
    test-command: 'crystal spec'
  c:
    enabled: true
  objc:
    enabled: true
