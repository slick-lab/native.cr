# .editorconfig

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cr]
indent_style = space
indent_size = 2
tab_width = 2

[*.yml]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 2

[*.xml]
indent_style = space
indent_size = 2

[*.toml]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
indent_size = 4
